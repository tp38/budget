@startuml 'classes relatives à accountPanel'

class JPanel #PaleVioletRed
class AccountSummaryPanel {
    + AccountSummaryPanel( RelaxDb db )
    - initTableModel( RelaxDb db ) : AccountSummaryTableModel
}

class DateSelector #LightGreen {
    + addActionListener( ActionListener l) : void
    + getDate() : Calendar
    + getLastDayofMonth() : Calendar
}

class AccountSummaryTableView #LightGreen

class RelaxDB #LightGreen {
    + getAccountList() : Result[]
    + getAccountSummary( String key, Calendar day ) : AccountSummary
}

AccountSummaryPanel -up-|> JPanel
AccountSummaryPanel "ds" *-- DateSelector
AccountSummaryPanel "ast" *-- AccountSummaryTableView
AccountSummaryPanel -> RelaxDB

@enduml